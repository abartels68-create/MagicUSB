{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/magicusb-release-v1.json",
  "title": "MagicUSB release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "minimum_firmware", "size", "sha256", "download_url"],
  "properties": {
    "schema_version": { "const": 1 },
    "release": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$" },
    "minimum_firmware": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "size": { "type": "integer", "minimum": 512, "multipleOf": 512 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "download_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "site": { "type": "string", "pattern": "^[A-Z0-9_-]{1,32}$" },
        "device_id": { "type": "string", "maxLength": 64 }
      }
    },
    "signature": { "type": "string", "description": "Base64 Ed25519 signature over canonical manifest fields; required after prototype." }
  }
}
